rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function agent() {
      return request.auth != null && exists(/databases/$(db)/documents/users/$(request.auth.uid));
    }
    function rank() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.rank; }
    function top() { return agent() && rank() in ['Director', 'Assistant Director']; }
    function knownRank() {
      return agent() && rank() in ['Director','Assistant Director','High Command','Detective III','Detective II','Detective I','Probationary Detective'];
    }
    function permission(key) {
      return !exists(/databases/$(db)/documents/config/main)
        ? (rank() == 'Probationary Detective' ? (key == 'interrogations' ? 'none' : 'view') : 'edit')
        : get(/databases/$(db)/documents/config/main).data.get('perms', {}).get(rank(), {}).get(key, rank() == 'Probationary Detective' ? 'view' : 'edit');
    }
    function view(key) { return top() || (knownRank() && permission(key) in ['view','edit']); }
    function edit(key) { return top() || (knownRank() && permission(key) == 'edit'); }
    function publicRecord(data) {
      return data.col == 'directives' || (data.col == 'documents' && data.get('isPublic', false) == true);
    }
    function publicProfile() {
      return request.resource.data.keys().hasOnly(['name','badge','rank','photo'])
        && request.resource.data.name is string && request.resource.data.badge is string
        && request.resource.data.rank is string && request.resource.data.photo is string;
    }
    match /config/{id} { allow read: if true; allow write: if top(); }
    match /mapLocations/{id} { allow read: if true; allow write: if false; }
    // Locations, including their linked photos, are public as in the original terminal.
    match /map/{id} { allow read: if true; allow write: if top(); }
    match /penal/{id} { allow read: if true; allow write: if edit('penal'); }
    match /roster/{id} {
      allow read: if true;
      allow create, update: if top() && publicProfile();
      allow delete: if top();
    }
    match /users/{id} {
      allow get: if request.auth != null && (request.auth.uid == id || top());
      allow list: if top();
      allow create, update, delete: if top();
    }
    function auditFor(id, data) {
      let entry = /databases/$(db)/documents/records/$(id)/history/$(data.auditId);
      return data.auditId is string && existsAfter(entry)
        && getAfter(entry).data.actorUid == request.auth.uid
        && getAfter(entry).data.version == data.version;
    }
    function draftRequest(data) {
      return data.col != 'warrants' || data.get('workflow', {}).get('status', 'Draft') == 'Draft';
    }
    function targetRequest(data) {
      return data.col != 'warrants' || (data.get('targets', []) is list && data.get('targets', []).size() > 0)
        || (data.get('otherTargets', '') is string && data.get('otherTargets', '').size() > 0);
    }
    function requestUpdate(old, next) {
      let previous = old.get('workflow', {}).get('status', 'Draft');
      let status = next.get('workflow', {}).get('status', 'Draft');
      return old.col != 'warrants' || (
        previous in ['Draft','Rejected'] && (status == 'Draft' || (previous == 'Rejected' && status == 'Rejected')
          || (status == 'Submitted' && next.workflow.submittedUid == request.auth.uid
            && next.workflow.submittedBy == get(/databases/$(db)/documents/users/$(request.auth.uid)).data.name))
      ) || (
        top() && previous == 'Submitted' && status in ['Approved','Rejected']
        && next.diff(old).affectedKeys().hasOnly(['workflow','version','updatedAt','auditId'])
        && next.workflow.diff(old.workflow).affectedKeys().hasOnly(['status','note','reviewedUid','reviewedBy','reviewedAt'])
        && next.workflow.reviewedUid == request.auth.uid
        && next.workflow.reviewedBy == get(/databases/$(db)/documents/users/$(request.auth.uid)).data.name
        && (status != 'Rejected' || next.workflow.note.size() > 0)
      );
    }
    match /records/{id} {
      function restoring() {
        let trash = /databases/$(db)/documents/trash/$(id);
        return exists(trash) && !get(trash).data.get('purging', false) && !existsAfter(trash)
          && request.resource.data.version == get(trash).data.record.get('version', 0) + 1
          && request.resource.data.diff(get(trash).data.record).affectedKeys().hasOnly(['version','auditId','updatedAt']);
      }
      allow get: if agent() && !exists(/databases/$(db)/documents/records/$(id));
      allow read: if publicRecord(resource.data) || view(resource.data.col);
      allow create: if edit(request.resource.data.col)
        && auditFor(id, request.resource.data)
        && ((request.resource.data.version == 1 && !exists(/databases/$(db)/documents/trash/$(id)) && draftRequest(request.resource.data) && targetRequest(request.resource.data)) || restoring());
      allow update: if request.resource.data.col == resource.data.col && edit(resource.data.col)
        && request.resource.data.version == resource.data.get('version', 0) + 1
        && request.resource.data.auditId != resource.data.get('auditId', '')
        && auditFor(id, request.resource.data) && targetRequest(request.resource.data)
        && requestUpdate(resource.data, request.resource.data);
      allow delete: if edit(resource.data.col)
        && existsAfter(/databases/$(db)/documents/trash/$(id))
        && getAfter(/databases/$(db)/documents/trash/$(id)).data.record == resource.data;
      match /history/{event} {
        function parent() { return /databases/$(db)/documents/records/$(id); }
        function trash() { return /databases/$(db)/documents/trash/$(id); }
        allow read: if (exists(parent()) && view(get(parent()).data.col))
          || (exists(trash()) && view(get(trash()).data.col));
        allow create: if agent() && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName == get(/databases/$(db)/documents/users/$(request.auth.uid)).data.name
          && request.resource.data.at == request.time
          && request.resource.data.keys().hasOnly(['actorUid','actorName','at','version','action','changes'])
          && ((existsAfter(parent()) && edit(getAfter(parent()).data.col)
              && getAfter(parent()).data.auditId == event
              && getAfter(parent()).data.version == request.resource.data.version
              && request.resource.data.action in ['created','updated','restored']
              && (!exists(parent()) || get(parent()).data.get('auditId', '') != event))
            || (!existsAfter(parent()) && existsAfter(trash()) && edit(getAfter(trash()).data.col)
              && getAfter(trash()).data.auditId == event && request.resource.data.action == 'trashed'));
        allow update: if false;
        allow delete: if top() && exists(trash()) && get(trash()).data.get('purging', false)
          && !exists(parent());
      }
    }
    match /trash/{id} {
      allow get: if agent() && !exists(/databases/$(db)/documents/trash/$(id));
      allow read: if view(resource.data.col);
      allow create: if edit(request.resource.data.col)
        && exists(/databases/$(db)/documents/records/$(id))
        && !existsAfter(/databases/$(db)/documents/records/$(id))
        && request.resource.data.record == get(/databases/$(db)/documents/records/$(id)).data
        && request.resource.data.col == request.resource.data.record.col
        && request.resource.data.deletedUid == request.auth.uid
        && request.resource.data.deletedAt == request.time
        && request.resource.data.keys().hasOnly(['col','record','deletedAt','deletedBy','deletedUid','auditId'])
        && existsAfter(/databases/$(db)/documents/records/$(id)/history/$(request.resource.data.auditId));
      allow update: if top()
        && !exists(/databases/$(db)/documents/records/$(id))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['purging','purgeUid','purgeStartedAt'])
        && request.resource.data.purging == true
        && request.resource.data.purgeUid == request.auth.uid
        && request.resource.data.purgeStartedAt == request.time;
      allow delete: if (top() && resource.data.get('purging', false)
          && !exists(/databases/$(db)/documents/records/$(id)))
        || (edit(resource.data.col) && !resource.data.get('purging', false)
        && existsAfter(/databases/$(db)/documents/records/$(id))
        && getAfter(/databases/$(db)/documents/records/$(id)).data.version == resource.data.record.get('version', 0) + 1);
    }
  }
}
